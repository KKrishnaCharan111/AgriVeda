# AgriVeda Environment Configuration Example
# Zero-Budget Mode: All features run locally with fallback mock/offline data out-of-the-box.
# No paid cloud subscriptions required for standard evaluation or local development.

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=agriveda_super_secret_jwt_key_replace_in_production_2026_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./agriveda.db
# For Production PostgreSQL:
# DATABASE_URL=postgresql://agriveda_user:agriveda_pass@localhost:5432/agriveda_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Uploads Directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# AI / Crop Doctor Configuration (Optional)
# If GEMINI_API_KEY is not provided, AgriVeda automatically uses the built-in
# Agricultural Knowledge Engine with verified Indian agronomy rule bases.
GEMINI_API_KEY=

# Weather Service Configuration
# Defaults to Open-Meteo public non-commercial API (Zero-budget, no API key needed).
WEATHER_PROVIDER=open-meteo
# Optional OpenWeatherMap API key (if switching provider):
OPENWEATHER_API_KEY=

# Mandi Market Prices Configuration
# Live Agmarknet / e-NAM data provider (falls back to verified mandi seed data):
AGMARKNET_API_KEY=

# Payment Gateway Configuration (Sandbox / Production)
# In zero-budget development mode, AgriVeda includes a full-fidelity sandbox simulator
# supporting PhonePe, Google Pay, Paytm, UPI QR, and Cards with instant verification.
PAYMENT_GATEWAY_PROVIDER=sandbox
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
WEBHOOK_SECRET=agriveda_webhook_signing_secret_2026

# SMS / Notification Provider (Optional)
# In development, SMS OTPs and alerts are printed to the server console and in-app bell notifications.
SMS_GATEWAY_PROVIDER=console
FAST2SMS_API_KEY=
